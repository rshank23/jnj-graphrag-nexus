# Optional: connect to Neo4j. Leave blank to use the local NetworkX graph (backend/data/jnj_graph.json).
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Optional hosted LLMs, tried in order Azure OpenAI -> OpenAI -> Gemini -> deterministic local grounded generation.
# Every call is metered (tokens, cost, latency) in the ops DB and visible under Data Sources & Ops.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Set to false to skip loading sentence-transformers even if it is installed.
USE_TRANSFORMER_MODELS=true
HTTP_TIMEOUT_SECONDS=15

# Torch-free semantic embeddings: directory with an exported MiniLM model.onnx + vocab.txt (optional).
ONNX_MODEL_DIR=

# Public regulatory/scientific data APIs. Keys are optional and only raise rate limits.
OPENFDA_API_KEY=
NCBI_API_KEY=

# Access control. false = open local demo (role taken from the X-Nexus-Role header, default "medical").
# true = every request needs X-Nexus-API-Key or an Entra ID bearer token. Roles: commercial | medical | mlr | admin.
REQUIRE_API_KEY=false
BOOTSTRAP_ADMIN_KEY=
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

# Observability: OpenTelemetry spans are exported when an OTLP endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Answers below this confidence are flagged for human review.
MIN_ANSWER_CONFIDENCE=0.35
# >0 runs a background refresh of due evidence sources (label-change monitor) every N hours.
AUTO_REFRESH_HOURS=0
